# syntax=docker/dockerfile:1.7
# Python worker (scan / CLAP embed / jobs) — internal only
FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg libsndfile1 \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml README.md ./
# Dependencies are intentionally installed before source code is copied.
# A normal code-only rebuild therefore reuses this expensive layer.
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --index-url "${TORCH_INDEX_URL}" "torch>=2.2.0"
RUN --mount=type=cache,target=/root/.cache/pip \
    python -c 'import subprocess, sys, tomllib; dependencies = tomllib.load(open("pyproject.toml", "rb"))["project"]["dependencies"]; dependencies = [item for item in dependencies if not item.lower().startswith("torch")]; subprocess.check_call([sys.executable, "-m", "pip", "install", *dependencies])'
COPY src ./src
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-deps -e .
# Same default ranker the Go player embeds. Mix generation reads it from the
# repo layout; without this copy the worker only has src/ and fails with Errno 2.
COPY player/internal/queue/model_default.json /app/player/internal/queue/model_default.json
ENV MUSIK_LIBRARY=/music \
    MUSIK_DATA_DIR=/data \
    MUSIK_EMBEDDINGS_CACHE=/data/cache/embeddings \
    MUSIK_ARTWORK_CACHE=/data/cache/artwork \
    MUSIK_WORKER_ADDR=0.0.0.0:8790 \
    MUSIK_PLAYER_RELOAD_URL=http://player:8787/api/reload \
    MUSIK_ROOT=/app
# Do not EXPOSE publicly in compose — only on internal network
VOLUME ["/data", "/music"]
CMD ["sh", "-c", "exec musik worker"]
